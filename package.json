{
  "name": "attendly",
  "version": "1.0.0",
  "private": true,
  "description": "Digital QR-based attendance system for UBT",
  "workspaces": [
    "packages/shared",
    "packages/backend",
    "packages/frontend"
  ],
  "scripts": {
    "dev:backend": "npm run dev -w @attendly/backend",
    "dev:frontend": "npm run dev -w @attendly/frontend",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "db:migrate": "npm run db:migrate -w @attendly/backend",
    "db:generate": "npm run db:generate -w @attendly/backend"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Erik-Jashari/Attendly.git"
  },
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/Erik-Jashari/Attendly/issues"
  },
  "homepage": "https://github.com/Erik-Jashari/Attendly#readme"
}
